                        - At least one special character<br>
                        - At least 13 characters<br>
                    </span>
                </span>
            </label><br>
            <input id="reset-password-new1" autocomplete="new-password" maxlength="100" name="New Password" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[\W_]).{13,}" placeholder="New Password" required="" style="width: 250px" type="password" value=""><br><br>
            <label for="reset-password-new2">New Password Again</label><br>
            <input id="reset-password-new2" autocomplete="new-password" maxlength="100" name="New Password Again" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[\W_]).{13,}" placeholder="New Password Again" required="" style="width: 250px" type="password" value=""><br><br>
            <input id="reset-button" type="button" value="Reset Password">
            <br><br>
            <div class="messages" id="reset-message"></div>
        </form>
    </div></div><div tabindex="-1" role="dialog" aria-modal="true" class="ui-dialog ui-corner-all ui-widget ui-widget-content ui-front" aria-describedby="identity-dialog" aria-labelledby="ui-id-6" style="display: none;"><div class="ui-dialog-titlebar ui-corner-all ui-widget-header ui-helper-clearfix"><span id="ui-id-6" class="ui-dialog-title">Edit Profile</span><button type="button" class="ui-button ui-corner-all ui-widget ui-button-icon-only ui-dialog-titlebar-close" title="Close"><span class="ui-button-icon ui-icon ui-icon-closethick"></span><span class="ui-button-icon-space"> </span>Close</button></div><div class="all-dialogs ui-dialog-content ui-widget-content" id="identity-dialog">
        <form id="identity-dialog-form" onsubmit="return false;">
            <p>
                Feel free to change your Name or Password below. You cannot change your email address. To delete your account and data, click 
                <a class="identity-delete-open-click" href="https://www.planttext.com/" target="_blank">here</a>.
            </p>
            <label for="identity-email">Email</label><br>
            <label id="identity-email" style="width: 250px; color: gray; border-width: 0"></label><br><br>
            <label for="identity-firstname">First Name</label><br>
            <input id="identity-firstname" autocomplete="given-name" maxlength="100" name="First Name" required="" style="width: 250px" type="text" value=""><br><br>
            <label for="identity-lastname">Last Name</label><br>
            <input id="identity-lastname" autocomplete="family-name" maxlength="100" name="Last Name" required="" style="width: 250px" type="text" value=""><br><br>
            <label for="identity-password">Current Password</label><br>
            <input id="identity-password" autocomplete="current-password" maxlength="100" name="Current Password" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{10,}" placeholder="Password" required="" style="width: 250px" type="password" value=""><br><br>
            <label for="identity-password-new1">New Password
                <span class="tooltip" tabindex="0">i
                    <span class="tooltip-text-bot">
                        New passwords must have:<br>
                        - At least one number<br>
                        - One lowercase letter<br>
                        - One uppercase letter<br>
                        - At least one special character<br>
                        - At least 13 characters<br>
                    </span>
                </span>
            </label><br>
            <input id="identity-password-new1" autocomplete="new-password" maxlength="100" name="New Password" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{10,}" placeholder="New Password" required="" style="width: 250px" type="password" value=""><br><br>
            <label for="identity-password-new2">New Password Again</label><br>
            <input id="identity-password-new2" autocomplete="new-password" maxlength="100" name="New Password Again" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{10,}" placeholder="New Password Again" required="" style="width: 250px" type="password" value=""><br><br>
            <input id="identity-button" type="button" value="Save Profile">
            <br><br>
            <div class="messages" id="identity-message"></div>
        </form>
    </div></div><div tabindex="-1" role="dialog" aria-modal="true" class="ui-dialog ui-corner-all ui-widget ui-widget-content ui-front" aria-describedby="identity-delete-dialog" aria-labelledby="ui-id-7" style="display: none;"><div class="ui-dialog-titlebar ui-corner-all ui-widget-header ui-helper-clearfix"><span id="ui-id-7" class="ui-dialog-title">Delete Profile</span><button type="button" class="ui-button ui-corner-all ui-widget ui-button-icon-only ui-dialog-titlebar-close" title="Close"><span class="ui-button-icon ui-icon ui-icon-closethick"></span><span class="ui-button-icon-space"> </span>Close</button></div><div class="all-dialogs ui-dialog-content ui-widget-content" id="identity-delete-dialog">
        <form id="identity-delete-dialog-form" onsubmit="return false;">
            <p>
                When you create a user profile in PlantText, we only store your authentication information on our servers. All of your data
                (settings and diagrams) is stored in your browser's local storage, NOT on our server. If you are wanting to delete the local
                data / diagrams, please go to the settings window.
            </p>
            <p>
                Warning! This CANNOT be undone. You will need to create an account again if you wish to sign in to PlantText. Your local data will not be
                lost by deleting this account because it is stored locally, but your user profile will be deleted from our server.
            </p>
            <input id="identity-delete-profile" type="button" value="Delete Server Profile Permanently">
            <br><br>
            <div class="messages" id="identity-delete-message"></div>
        </form>
    </div></div><div tabindex="-1" role="dialog" aria-modal="true" class="ui-dialog ui-corner-all ui-widget ui-widget-content ui-front" aria-describedby="identity-delete-local-dialog" aria-labelledby="ui-id-8" style="display: none;"><div class="ui-dialog-titlebar ui-corner-all ui-widget-header ui-helper-clearfix"><span id="ui-id-8" class="ui-dialog-title">Delete Local Data</span><button type="button" class="ui-button ui-corner-all ui-widget ui-button-icon-only ui-dialog-titlebar-close" title="Close"><span class="ui-button-icon ui-icon ui-icon-closethick"></span><span class="ui-button-icon-space"> </span>Close</button></div><div class="all-dialogs ui-dialog-content ui-widget-content" id="identity-delete-local-dialog">
        <form id="identity-delete-local-dialog-form" onsubmit="return false;">
            <p>
                All of your data (settings and diagrams) is stored in your browser's local storage, NOT our server.
                Press the button below to delete the local storage for this website.
            </p>
            <p>
                Warning! This cannot be undone. All of your settings and diagrams will be deleted.
                If you have an account, your user profile will not be affected, but all your local data will be
                DELETED PERMANENTLY. You may want to use this button if you are on a public computer and need to
                permanently remove your settings and diagrams for instance. Please make sure to backup your diagrams
                first though!
            </p>
            <input id="identity-delete-local" type="button" value="Delete Local Data Permanently"><br><br>
        </form>
    </div></div><div tabindex="-1" role="dialog" class="ui-dialog ui-corner-all ui-widget ui-widget-content ui-front ui-draggable ui-resizable" aria-describedby="help-dialog" aria-labelledby="ui-id-9" style="display: none; position: absolute;"><div class="ui-dialog-titlebar ui-corner-all ui-widget-header ui-helper-clearfix ui-draggable-handle"><span id="ui-id-9" class="ui-dialog-title">Help</span><button type="button" class="ui-button ui-corner-all ui-widget ui-button-icon-only ui-dialog-titlebar-close" title="Close"><span class="ui-button-icon ui-icon ui-icon-closethick"></span><span class="ui-button-icon-space"> </span>Close</button></div><div class="all-dialogs ui-dialog-content ui-widget-content" id="help-dialog">
        <form id="help-dialog-form" onsubmit="return false;">
            <div id="helpitem"></div>
        </form>
    </div><div class="ui-resizable-handle ui-resizable-n" style="z-index: 90;"></div><div class="ui-resizable-handle ui-resizable-e" style="z-index: 90;"></div><div class="ui-resizable-handle ui-resizable-s" style="z-index: 90;"></div><div class="ui-resizable-handle ui-resizable-w" style="z-index: 90;"></div><div class="ui-resizable-handle ui-resizable-se ui-icon ui-icon-gripsmall-diagonal-se" style="z-index: 90;"></div><div class="ui-resizable-handle ui-resizable-sw" style="z-index: 90;"></div><div class="ui-resizable-handle ui-resizable-ne" style="z-index: 90;"></div><div class="ui-resizable-handle ui-resizable-nw" style="z-index: 90;"></div></div><div tabindex="-1" role="dialog" class="ui-dialog ui-corner-all ui-widget ui-widget-content ui-front ui-draggable" aria-describedby="settings-dialog" aria-labelledby="ui-id-10" style="display: none;"><div class="ui-dialog-titlebar ui-corner-all ui-widget-header ui-helper-clearfix ui-draggable-handle"><span id="ui-id-10" class="ui-dialog-title">Settings</span><button type="button" class="ui-button ui-corner-all ui-widget ui-button-icon-only ui-dialog-titlebar-close" title="Close"><span class="ui-button-icon ui-icon ui-icon-closethick"></span><span class="ui-button-icon-space"> </span>Close</button></div><div class="all-dialogs ui-dialog-content ui-widget-content" id="settings-dialog">
        <form id="settings-dialog-form" onsubmit="return false;">
            <fieldset class="field-set">
                <legend>All Users</legend>
                <div class="container-2-columns">
                    <label>Layout</label>
                    <input checked="" id="layout-portrait" name="layout-radiobuttons" type="radio" value="portrait">
                    <label for="layout-portrait">Portrait</label> 
                    <input id="layout-landscape" name="layout-radiobuttons" type="radio" value="landscape">
                    <label for="layout-landscape">Landscape</label> <br><br>
                    <input id="darkthemeall-checkbox" type="checkbox">
                    <label for="darkthemeall-checkbox">Dark Theme</label><br><br>
                    <span title="Select a diagram theme to place a &#39;!theme &lt;name&gt;&#39; tag into the body of your editor.">
                        <label for="diagram-themes-dropdown">Diagram Theme</label>
                        <select id="diagram-themes-dropdown" size="1">
                            <option selected="selected" value="_none_">Diagram theme...</option>
