                    </select> <br><br>
                    <input id="usesofttabs-checkbox" type="checkbox"> 
                    <label for="usesofttabs-checkbox">Use Soft Tabs</label>
                    <select id="tabsize-dropdown" size="1">
                        <option value="1">1 space</option>
                        <option selected="selected" value="2">2 space</option>
                        <option value="3">3 space</option>
