                    <input id="liveautocompletion-checkbox" type="checkbox">
                    <label for="liveautocompletion-checkbox">Live Autocompletion</label><br><br>
                    <input id="highlightactiveline-checkbox" type="checkbox">
                    <label for="highlightactiveline-checkbox">Highlight Active Line</label><br><br>
                    <input id="hidenumbers-checkbox" type="checkbox">
                    <label for="hidenumbers-checkbox">Show Numbers</label><br><br>
                    <input id="usewrapmode-checkbox" type="checkbox">
                    <label for="usewrapmode-checkbox">Use Wrap Mode</label><br><br>
                    <input id="identity-delete-local-button" type="button" value="Delete Local Data"><br><br>
                    <input id="settingsdefault-button" type="button" value="Settings to Defaults"><br><br>
                    <label>Keystrokes:</label>
                    <pre style="font-size: smaller">Refresh on Win (Alt+Enter)
Refresh on Mac (Cmd+Enter)
Autocompletion (Ctrl+Space)
Undo Edits     (Ctrl+Z)
Redo Edits     (Ctrl+Y)
                    </pre>
                </div>
            </fieldset>
            <br>
            <fieldset class="field-set" id="settings-dialog-registered-group" disabled="">
                <legend>Logged In Users</legend>
                <div class="container-2-columns">
                    <input id="snippet-checkbox" type="checkbox">
                    <label for="snippet-checkbox">Snippets</label>
                    <select id="snippet-types-dropdown" size="1" disabled="">
                        <option selected="selected" value="_none_">None</option>
                        <option value="snippets-activity">Activity</option>
                        <option value="snippets-class">Class</option>
                        <option value="snippets-component">Component</option>
                        <option value="snippets-deployment">Deployment</option>
                        <option value="snippets-general">General</option>
                        <option value="snippets-object">Object</option>
