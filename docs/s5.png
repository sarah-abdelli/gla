                </div>
            </fieldset>
            <br>
        </form>
    </div></div><div tabindex="-1" role="dialog" class="ui-dialog ui-corner-all ui-widget ui-widget-content ui-front ui-draggable" aria-describedby="scripting-dialog" aria-labelledby="ui-id-11" style="display: none;"><div class="ui-dialog-titlebar ui-corner-all ui-widget-header ui-helper-clearfix ui-draggable-handle"><span id="ui-id-11" class="ui-dialog-title">Link Maker</span><button type="button" class="ui-button ui-corner-all ui-widget ui-button-icon-only ui-dialog-titlebar-close" title="Close"><span class="ui-button-icon ui-icon ui-icon-closethick"></span><span class="ui-button-icon-space"> </span>Close</button></div><div class="all-dialogs ui-dialog-content ui-widget-content" id="scripting-dialog">
        <form id="scripting-dialog-form" onsubmit="return false;">
            <fieldset class="field-set-blank" id="scripting-dialog-registered-group" disabled="" title="Sign in to access this feature.">
                <p>
                    Convert raw PlantUML into a URL. The URL can then be copied into a browser to display
                    the diagram image. Useful for pasting diagrams into documents or uploading them to 
                    other websites. 
                </p>
                <select id="scripting-imagetype" size="1">
                    <option value="png">PNG</option>
                    <option value="svg">SVG</option>
                    <option value="txt">ASCI Text</option>
                </select>
                <input id="scripting-button" type="button" value="PlantUML to Link"><br><br>
                <textarea id="scripting-output" rows="8"></textarea>
            </fieldset>
            <br><br>
            <a id="scripting-message" href="https://www.planttext.com/" onclick="openJqueryUiDialog(&#39;login-dialog&#39;); return false;" style="color: rgb(255, 0, 0);">Sign in to access this feature.</a>
        </form>
    </div></div><div tabindex="-1" role="dialog" class="ui-dialog ui-corner-all ui-widget ui-widget-content ui-front ui-draggable" aria-describedby="sendtoemail-dialog" aria-labelledby="ui-id-12" style="display: none;"><div class="ui-dialog-titlebar ui-corner-all ui-widget-header ui-helper-clearfix ui-draggable-handle"><span id="ui-id-12" class="ui-dialog-title">Send Diagram To Email</span><button type="button" class="ui-button ui-corner-all ui-widget ui-button-icon-only ui-dialog-titlebar-close" title="Close"><span class="ui-button-icon ui-icon ui-icon-closethick"></span><span class="ui-button-icon-space"> </span>Close</button></div><div class="all-dialogs ui-dialog-content ui-widget-content" id="sendtoemail-dialog">
        <form id="sendtoemail-dialog-form" onsubmit="return false;">
            <fieldset class="field-set-blank" id="sendtoemail-dialog-registered-group" disabled="" title="Upgrade to Pro to access this feature.">
                <p>Send the current diagram directly to your email address.</p>
                <label for="sendtoemail-name">Name</label>
                <input autocomplete="off" id="sendtoemail-name" maxlength="200" placeholder="Enter Diagram Name" style="width: 55%" type="text" value="" required=""><br><br>
                <label for="sendtoemail-imagetype">URL Type</label>
                <select id="sendtoemail-imagetype" size="1">
                    <option value="png">PNG</option>
                    <option value="svg">SVG</option>
                    <option value="txt">TXT</option>
                    <option value="share">Share</option>
                </select><br><br>
                <input id="sendtoemail-button" type="button" value="Send Email">
            </fieldset>
            <br><br>
            <a id="sendtoemail-message" href="https://www.planttext.com/" onclick="openJqueryUiDialog(&#39;subscribe-dialog&#39;); return false;" style="color: rgb(255, 0, 0);">Upgrade to Pro to access this feature.</a>
        </form>
    </div></div><div tabindex="-1" role="dialog" class="ui-dialog ui-corner-all ui-widget ui-widget-content ui-front ui-draggable" aria-describedby="plantumlserver-dialog" aria-labelledby="ui-id-13" style="display: none;"><div class="ui-dialog-titlebar ui-corner-all ui-widget-header ui-helper-clearfix ui-draggable-handle"><span id="ui-id-13" class="ui-dialog-title">Change the PlantUML Server</span><button type="button" class="ui-button ui-corner-all ui-widget ui-button-icon-only ui-dialog-titlebar-close" title="Close"><span class="ui-button-icon ui-icon ui-icon-closethick"></span><span class="ui-button-icon-space"> </span>Close</button></div><div class="all-dialogs ui-dialog-content ui-widget-content" id="plantumlserver-dialog">
        <form id="plantumlserver-dialog-form" onsubmit="return false;">
            <fieldset class="field-set-blank" id="plantumlserver-dialog-registered-group" disabled="" title="Upgrade to Pro to access this feature.">
                <p>
                    If you prefer to use your own PlantUML server, enter its URL below. Click 'Default' to revert to the PlantText 
                    server.
                </p>
                <details>
                    <summary>Details</summary>
                    <p>
                        There are a number of reasons to point to a different server. Feel free to do so. If the textbox is blank 
                        it is using the PlantText server. Include the full protocol, domain, port, and path. For example the official
                        PlantUML server is located at...
                    </p>
                    <p>https://www.plantuml.com/plantuml/</p>
                    
                </details><br>
                <label for="plantumlserver-default-button">PlantUML Server</label><br>
                <input id="plantumlserver-default-button" type="button" value="Default">
                <input autocomplete="url" pattern="https://.*" id="plantumlserver-textbox" type="text" value=""><br><br>
                <input id="plantumlserver-save-button" type="button" value="Save PlantUML Server">
            </fieldset>
            <br><br>
            <a id="plantumlserver-message" href="https://www.planttext.com/" onclick="openJqueryUiDialog(&#39;subscribe-dialog&#39;); return false;" style="color: rgb(255, 0, 0);">Upgrade to Pro to access this feature.</a>
        </form>
    </div></div><div tabindex="-1" role="dialog" class="ui-dialog ui-corner-all ui-widget ui-widget-content ui-front ui-draggable ui-resizable" aria-describedby="webhook-dialog" aria-labelledby="ui-id-14" style="display: none; position: absolute;"><div class="ui-dialog-titlebar ui-corner-all ui-widget-header ui-helper-clearfix ui-draggable-handle"><span id="ui-id-14" class="ui-dialog-title">Send Diagram To Web Hook</span><button type="button" class="ui-button ui-corner-all ui-widget ui-button-icon-only ui-dialog-titlebar-close" title="Close"><span class="ui-button-icon ui-icon ui-icon-closethick"></span><span class="ui-button-icon-space"> </span>Close</button></div><div class="all-dialogs ui-dialog-content ui-widget-content" id="webhook-dialog">
        <form class="display-flex" onsubmit="return false;">
            <fieldset class="field-set-blank display-flex" id="webhook-dialog-registered-group" disabled="" title="Upgrade to Pro to access this feature.">
                <p>
                    Send the current diagram link to your own webhook. Supported services include
                    <a href="https://zapier.com/apps/webhook/integrations" target="_blank">Zapier</a>, <a href="https://hook.io/" target="_blank">Hook.io,</a> and
                    <a href="https://ifttt.com/maker_webhooks" target="_blank">IFTTT</a>.
                </p>
                <details>
                    <summary>Details</summary>
                    <p>
                        There are many use cases for sending your diagram link to a webhook. For instance, you can use Zapier to save
                        diagrams to Google Drive or email to your colleagues. Let your imagination run wild! </p>
                    <p>
                        The webhook must accept the POST HTTP verb and take a JSON data payload in the body of the request. Take a look
                        at the Request field below for details. And the Webhook URL must be secure (use HTTPS) and use a supported
                        domain.
                    </p>
                    <p>
                        Below is a list of supported webhook domains. Please contact us at
                        <a href="mailto:admin@planttext.com" target="_blank">admin@planttext.com</a> with any domains that should
                        be added to this list.
                    </p>
                    <p><span id="webhook-domains-allowed"></span></p>
                </details><br>
                <div class="display-flex-row">
                    <label for="webhook-name">Name</label>
                    <input id="webhook-name" style="width: 40ch;" autocomplete="off" maxlength="40" placeholder="Enter Diagram Name" required="" type="text" value="">&nbsp;
                    <label for="webhook-imagetype">URL Type</label>
                    <select id="webhook-imagetype" size="1">
                        <option value="png">PNG</option>
                        <option value="svg">SVG</option>
                        <option value="txt">TXT</option>
                    </select>
                </div><br>
                <label for="webhook-hook">Webhook URL
                    <span class="tooltip" tabindex="0">i
                        <span class="tooltip-text-bot">
                            This should be a full URL like...<br>
                            https://hooks.zapier.com/mywebhookcode<br>
                            - It needs to include HTTPS (not HTTP)<br>
                            - It must be in the domain list above<br>
                            - Email us your domain to include it<br>
                        </span>
                    </span>
                </label>
                <input id="webhook-hook" autocomplete="url" pattern="https://.*" maxlength="2000" placeholder="Webhook URL" required="" type="text"><br>
                <div class="display-flex-row-noexpand">
                    <details>
                        <summary>Request</summary>
                        <textarea cols="50" id="webhook-request" rows="8" wrap="soft" style="width: 98%;" readonly=""></textarea>
                    </details>
                </div>    
                <br>
                <label for="webhook-response">Response</label>
                <textarea class="flex-grow-expand" id="webhook-response" rows="8" wrap="soft" readonly=""></textarea>
                <div class="display-flex-row">
                    <input id="webhook-button" type="button" value="Send Request">
                </div>
            </fieldset>
            <br>
            <a id="webhook-message" href="https://www.planttext.com/" onclick="openJqueryUiDialog(&#39;subscribe-dialog&#39;); return false;" style="color: rgb(255, 0, 0);">Upgrade to Pro to access this feature.</a>
        </form>
