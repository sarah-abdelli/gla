                    <span title="Detect diagram type &amp; match snippets">
                        <input id="editor-toolbar-detect-snippets-button" type="button" value="Auto" disabled="">
                    </span>
                    <br><br>
                    <input id="syntaxhighlighting-checkbox" type="checkbox">
                    <label for="syntaxhighlighting-checkbox">Syntax Highlighting</label>
                    <select id="mode-dropdown" size="1" disabled="">
                        <option value="javascript">Javascript</option>
